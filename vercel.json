{
  "version": 2,
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "api/static/**",
          "conductor/**",
          "config/**",
          "integrations/**",
          "knowledge_base/**",
          "utils/**",
          "voice/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/server.py" }
  ]
}
